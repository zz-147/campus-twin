{
  "servers": [
    {
      "name": "filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\zdsh\\campus-twin\\configs",
        "D:\\zdsh\\campus-twin\\docs"
      ],
      "env": {
        "NPM_CONFIG_REGISTRY": "https://registry.npmmirror.com",
        "NPM_CONFIG_CACHE": "D:\\zdsh\\campus-twin\\mcp_bridge\\data\\npm-cache"
      },
      "allowed_tools": [
        "read_file",
        "read_text_file",
        "read_media_file",
        "read_multiple_files",
        "list_directory",
        "list_directory_with_sizes",
        "directory_tree",
        "search_files",
        "get_file_info",
        "list_allowed_directories"
      ]
    },
    {
      "name": "memory",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "NPM_CONFIG_REGISTRY": "https://registry.npmmirror.com",
        "NPM_CONFIG_CACHE": "D:\\zdsh\\campus-twin\\mcp_bridge\\data\\npm-cache",
        "MEMORY_FILE_PATH": "D:\\zdsh\\campus-twin\\mcp_bridge\\data\\memory.json"
      },
      "allowed_tools": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ]
    }
  ]
}
