# ============================================================================
# campus-twin AI 运维 Agent —— 环境变量示例
# 复制为 .env 后填写（.env 已被 .gitignore 排除，API key 绝不提交/写进代码）
# ============================================================================

# ---- LLM provider（默认 DeepSeek；改这里即可随时换模型） --------------------
# 可选值：deepseek | openai | ollama | mock | openai_compat
LLM_PROVIDER=deepseek

# API key（DeepSeek 或 OpenAI 的 key；只从 .env/环境变量读取）
LLM_API_KEY=

# base_url / model（留空则使用 provider 默认值；自建端点/Ollama 必须填）
# DeepSeek 默认：https://api.deepseek.com/v1  + deepseek-chat
LLM_BASE_URL=
LLM_MODEL=

# 生成参数
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# ---- 后端数据源（Agent 工具读取的 campus-twin 后端） -----------------------
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_S=5

# http = 读取真实后端（默认）；fixture = 离线评测快照（无需后端）
AGENT_DATA_SOURCE=http
# fixture 模式下可指定场景（如 s01/s15/s19）注入故障，便于无后端演示
AGENT_FIXTURE_SCENARIO=

# ---- Agent 行为 ------------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8

# ---- W9：会话持久化 / action 确认协议 / 多 Agent ---------------------------
# 会话与 action 的 SQLite 文件（默认 campus-twin/agent/data/agent.db）
AGENT_DB_PATH=
# action 确认有效期（秒），默认 10 分钟；过期需重新发起
AGENT_ACTION_TTL_S=600
# 真实 LLM 时是否让主 Agent 对子 Agent 结论做一次汇总润色（0/1）
AGENT_POLISH_LLM=1

# ---- W11：LangGraph 编排引擎（可回退） -------------------------------------
# langgraph = W11 新引擎（StateGraph + SqliteSaver + interrupt 人机确认，默认）
# classic   = W10 原 Orchestrator（保留回退，现场演示可随时切换）
AGENT_ENGINE=langgraph
# LangGraph checkpointer SQLite 文件（thread_id=conversation_id 持久化多轮状态）
# 留空默认 campus-twin/agent/data/graph.db
AGENT_GRAPH_DB_PATH=

# ---- W13：MCP Bridge（外部 filesystem/memory 工具，只读接入） --------------
# 本机 MCP Bridge 地址（bridge 需另行启动：mcp_bridge/bridge.py，127.0.0.1:8200）
MCP_BRIDGE_BASE=http://127.0.0.1:8200
MCP_BRIDGE_TIMEOUT_S=5

# ---- API 服务（:8100） -----------------------------------------------------
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8100
AGENT_LOG_LEVEL=INFO

# ============================================================================
# 切换示例：
# 1) DeepSeek（默认）：LLM_PROVIDER=deepseek + LLM_API_KEY=sk-...
# 2) OpenAI：          LLM_PROVIDER=openai   + LLM_API_KEY=sk-... + LLM_MODEL=gpt-4o-mini
# 3) 本地 Ollama：     LLM_PROVIDER=ollama   + LLM_BASE_URL=http://127.0.0.1:11434/v1 + LLM_MODEL=qwen2.5:7b
# 4) 任意兼容端点：     LLM_PROVIDER=openai_compat + LLM_BASE_URL=... + LLM_MODEL=...
# 5) 无 key 离线演示：  LLM_PROVIDER=mock
# ============================================================================
