# 飞书自建应用凭证（必填，仅本地使用；不要提交仓库）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Agent 地址（校园网络数字孪生平台 AI Agent）
AGENT_BASE=http://127.0.0.1:8100

# 安全：允许使用机器人的群聊/用户（留空 = 允许所有群；建议填群 chat_id 白名单）
BOT_ALLOWED_CHAT_IDS=
BOT_ALLOWED_USER_IDS=

# 频率限制（每个群每分钟最多请求数）
BOT_RATE_LIMIT_PER_MIN=10

# 单条飞书消息最大字符数（超出自动分条）
BOT_MAX_REPLY_CHARS=3800

# Agent 请求超时（毫秒，AI 回答通常 20~40 秒）
AGENT_TIMEOUT_MS=240000

LOG_LEVEL=info
